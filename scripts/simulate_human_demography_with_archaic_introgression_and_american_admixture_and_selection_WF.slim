// This occurs (5919.131117 generations)*(25 years)=147978 yr ago; paper rounds to 5920 gens (148000 yr)
// Thus, simulation should end at generation 1+73104+5919.131117=79024

10 early() {
	sim.addSubpopSplit("p5", 2800, p1); // AMH - Neanderthal split 700kya 
}



8011 early() {
	sim.addSubpopSplit("p6", 2600, p5); // Neanderthal - Denisovan split 500kya (700,000 - 500000) / 25 + 10
}

22091 early() { p1.setSubpopulationSize(14474); } // paper rounds to 14474 5920 ga --> 148kya --> (700000-148000)/25 + 10

23611 early() { sim.treeSeqRememberIndividuals(p5.individuals[rdunif(1, 0, length(p5.individuals))]); } // remember Neanderthal individuals to sample a Neanderthal genome 110kya (700000 - 110000)/25 + 10

25239 early() { sim.treeSeqRememberIndividuals(p6.individuals[rdunif(1, 0, length(p6.individuals))]); } // remember Denisovan individuals to sample a Denisovan genome 69.3kya (700000 - 69300)/25 + 10

// SPLIT Eurasians (p2) from Africans (p1) and SET UP MIGRATION between them
// This occurs 2056.396652 generations (51409.9163 years) ago; paper rounds to 2040 gens (51000 yr)
// Relative to beginning, this is generation (700000-51000)/25 +10
25971 early() {
	sim.addSubpopSplit("p2", 1861, p1); // paper rounds to 1861
	p1.setMigrationRates(c(p2), c(15e-5)); // paper rounds to 15e-5
	p2.setMigrationRates(c(p1), c(15e-5)); // paper rounds to 15e-5
}


26009 late() { // add marker mutations to Neanderthal genome
	positions = seq(from=0, to=L, by=4000);
	// p5.genomes.addNewDrawnMutation(m5, positions);
	p5.genomes.addNewDrawnMutation(m1, positions);
}
26010 early() {

	p2.setMigrationRates(c(p5), c(0.05)); //5% Neanderthal introgression 50 kya 102006 - 50000/25=100006
}
26011 early() {
	p2.setMigrationRates(c(p5), c(0.0));
}

// Neanderthal and Denisovan go extinct 30 kya
26810 early() {
	p5.setSubpopulationSize(0);
	p6.setSubpopulationSize(0);
}
// SPLIT p2 into European (p2) and East Asian (p3) subpopulations; RESIZE; SET UP MIGRATION between them
// This occurs 939.8072428 generations (23495.18107 years) ago; paper rounds to 920 gens (23000 yr)
27090 early() {
	sim.addSubpopSplit("p3", 554, p2); // paper rounds to 554
	p2.setSubpopulationSize(1032);  // reduce European size; paper rounds to 1032

	// Set migration rates for the rest of the simulation
	p1.setMigrationRates(c(p2, p3), c(2.5e-5, 0.78e-5)); // paper rounds to c(2.5e-5, 0.78e-5)
	p2.setMigrationRates(c(p1, p3), c(2.5e-5, 3.11e-5)); // paper rounds to c(2.5e-5, 3.11e-5)
	p3.setMigrationRates(c(p1, p2), c(0.78e-5, 3.11e-5)); // paper rounds to c(0.78e-5, 3.11e-5)
}
// SET UP EXPONENTIAL GROWTH in Europe (p2) and East Asia (p3)
// Where N(0) is the base subpopulation size and t = gen - 101086:
//    N(Europe) should be int(round(N(0) * (1 + 0.003784324268)^t)), i.e., growth is r=0.38% per generation
//    N(East Asia) should be int(round(N(0) * (1 + 0.004780219543)^t)), i.e., growth is r=0.48% per generation
27090:27994 early() {
	t = sim.cycle - 27090;
	p2_size = round(1032 * (1 + 0.0038)^t); // paper rounds to N(0)=1032 and r=0.0038
	p3_size = round(554 * (1 + 0.0048)^t); // paper rounds to N(0)=554 and r=0.0048
	
	p2.setSubpopulationSize(asInteger(p2_size));
	p3.setSubpopulationSize(asInteger(p3_size));
}


